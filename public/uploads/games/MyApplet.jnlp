<?xml version="1.0" encoding="UTF-8"?>
<jnlp spec="1.0+" codebase="http://localhost:8080/" href="MyApplet.jnlp">
    <information>
        <title>My Swing Application</title>
        <vendor>Muhammad</vendor>
        <description>My Swing Application</description>
        <offline-allowed/>
    </information>
    <resources>
        <j2se version="1.8+" href="http://java.sun.com/products/autodl/j2se"/>
        <jar href="MyApplet.jar" main="true"/>
    </resources>
    <application-desc main-class="MyApplet"/>
</jnlp>
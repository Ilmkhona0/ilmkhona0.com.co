# Copy this file to .env.production ON THE SERVER and fill in real values.
# Take the values from your existing .env.local / Vercel dashboard (Settings > Environment Variables).

# --- Database (MongoDB Atlas — same connection string as before) ---
MONGODB_URI=

# --- Auth (NextAuth v5) ---
AUTH_SECRET=            # generate with: openssl rand -base64 32
AUTH_URL=https://ilmkhona0.com.co
AUTH_TRUST_HOST=true    # REQUIRED when not on Vercel
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- File storage ---
# Option A (easiest): keep Vercel Blob — copy the token from Vercel; works from any server.
# Option B: leave empty — the app falls back to local disk (persisted via the ./uploads volume).
BLOB_READ_WRITE_TOKEN=

# --- AI features ---
GROQ_API_KEY=
GROQ_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Google (all optional; blank = feature simply doesn't load) ---
# AdSense publisher id, "ca-pub-…" — ads that pay you. Also drives /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Google Analytics 4 measurement id, "G-…"
NEXT_PUBLIC_GA_ID=
# Google Ads conversion id, "AW-…"
NEXT_PUBLIC_GOOGLE_ADS_ID=
# NOTE: NEXT_PUBLIC_* vars are baked in at BUILD time. After changing these you
# must rebuild (npm run build) and restart — a plain restart is not enough.
